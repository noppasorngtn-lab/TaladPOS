# .NET (api/)
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Node.js (web/) - web/.gitignore also covers this locally
**/node_modules/
**/.next/
**/out/

# Environment / secrets
.env
.env.*
!.env.example
!.env*.example

# Uploaded product images (runtime content, not source) — keep the folder via .gitkeep
api/src/TaladPOS.Api/wwwroot/product-images/*
!api/src/TaladPOS.Api/wwwroot/product-images/.gitkeep

# Playwright E2E test output (regenerated per run)
web/test-results/
web/playwright-report/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.swp
